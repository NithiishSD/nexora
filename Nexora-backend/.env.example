# Development variables (10-DEPLOYMENT section 5.1). Copy to .env (git-ignored), then: set -a; source .env; set +a;
# ./gradlew bootRun. Spring reads the environment, not this file. Production uses deploy/.env.prod.example.

# =================================================================================================
# 1. CORE DATABASE & SERVER (ACTIVE)
# =================================================================================================
# --- database (docker-compose.yml reads DB_PASSWORD; the app reads all of them) ---
# JDBC address of PostgreSQL 17 (the local compose database listens on 5431)
DB_URL=jdbc:postgresql://localhost:5431/nexora_db
DB_USERNAME=postgres
# must stay nexora_dev unless docker-compose.yml is changed with it
DB_PASSWORD=nexora_dev

# --- server ---
# HTTP port of the API
SERVER_PORT=8080
# second, unpublished port for /actuator/prometheus and /actuator/metrics (0 = none)
MANAGEMENT_PORT=8081

# --- security (dev-only values; production values are generated, never copied from here) ---
# HS256 signing key, at least 32 bytes (openssl rand -base64 48)
JWT_SECRET=dev-only-secret-change-me-at-least-32-bytes-long
# access and refresh token lifetimes (Spring durations)
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# wrong passwords in a row before an account is locked, and for how long
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT=15m
# per-IP and per-user request limits (NFR-SEC-11); keep true outside tests
RATE_LIMIT_ENABLED=true
# first OWNER account, created only while the users table is empty
BOOTSTRAP_OWNER_USERNAME=owner
BOOTSTRAP_OWNER_PASSWORD=DevOwner#2026pass

# --- documents (uploaded bills and statements) ---
DOCUMENTS_DIR=./data/documents

# --- migrations (prod profile only; dev migrates with the DB_* user) ---
FLYWAY_URL=jdbc:postgresql://localhost:5431/nexora_db
FLYWAY_USER=postgres
FLYWAY_PASSWORD=nexora_dev

# =================================================================================================
# 2. OPERATIONAL & QUALITY GATES (RELEASE PREPARATION & AUTOMATION)
# =================================================================================================
# --- security audits (NFR-SEC-07, M7 gate) ---
# Required for ./gradlew dependencyCheckAnalyze (free key from: https://nvd.nist.gov/developers/request-an-api-key)
NVD_API_KEY=1D1AA2CC-D45B-4E11-9137-5EE20389498D

# --- backup & health monitoring (M8 / RUNBOOK) ---
# Destination remote for backup.sh (local directory or remote cloud vault via rclone)
RCLONE_REMOTE=local-backups:./data/backups
# Recipient public key for age backup encryption (standard 62-character age1 recipient key format)
AGE_PUBLIC_KEY=age1ql3z7hjy54pw3hyww5ayyfg7zqgvc7w3j2elw8zmrj2kg5wh98qqvq8msr
# Dead-man's-switch ping URL pinged on backup success (e.g. healthchecks.io or local actuator probe)
HEALTHCHECK_PING_URL=http://localhost:8080/actuator/health
# Webhook URL for host-check.sh alert notifications (e.g. ntfy.sh, Slack, or Discord webhook)
ALERT_WEBHOOK_URL=http://localhost:8080/actuator/info

# =================================================================================================
# 3. FEATURE INTEGRATIONS & CLOUD CONNECTORS (PRE-CONFIGURED WITH SANDBOX DEFAULTS)
# =================================================================================================
# --- WhatsApp Business API notifications (FR-NTF-08) ---
# Automated dispatch of POs, payment acknowledgements, and delivery notes
WHATSAPP_API_ENABLED=false
WHATSAPP_API_URL=https://graph.facebook.com/v19.0
WHATSAPP_PHONE_NUMBER_ID=109283746501928
WHATSAPP_ACCESS_TOKEN=EAAG_sandbox_token_replace_with_meta_business_token

# --- GST e-Invoicing & E-Way Bill Portal (FR-DOC-06) ---
# Automated generation of IRN, QR code and E-Way bills from delivery notes
GST_EINVOICE_ENABLED=false
GST_API_BASE_URL=https://api-sandbox.einvoice.nic.in
GST_CLIENT_ID=sandbox_client_nexora
GST_CLIENT_SECRET=sandbox_secret_nexora_2026
GST_AUTH_TOKEN=sandbox_auth_token_mock
GSTIN=33AAAAA0000A1Z5

# --- Banking & Automated Statement Feeds (FR-FIN-20) ---
# Direct bank statement synchronization (Open Banking / aggregators) for cash/bank reconciliation
BANK_INTEGRATION_ENABLED=false
BANK_API_BASE_URL=http://localhost:8089/api/v1/bank-feed
BANK_CLIENT_ID=nexora_bank_sandbox_client
BANK_CLIENT_SECRET=nexora_bank_sandbox_secret

# --- Cloud Object Storage (FR-DOC-01 multi-node storage) ---
# Switch between 'local' filesystem (DOCUMENTS_DIR) and S3-compatible cloud storage (AWS / MinIO)
STORAGE_PROVIDER=local
S3_ENDPOINT=http://localhost:9000
S3_BUCKET_NAME=smartsilk-documents
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# --- AI Document OCR & Intelligent Parsing (FR-DOC-06 future enhancement) ---
# Automated data extraction (weights, counts, amounts) from uploaded supplier bills and transport slips
AI_OCR_PROVIDER=gemini
GEMINI_API_KEY=AIzaSy_demo_replace_with_your_google_ai_gemini_api_key

# --- Application Performance Monitoring & Error Tracking ---
# Real-time exception capture and distributed tracing
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
