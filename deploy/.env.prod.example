# Production variables (10-DEPLOYMENT section 5.2). Copy to deploy/.env.prod on the server (chmod 600), fill every
# empty value, never commit the copy. Compose reads it for ${...} substitution (--env-file) and passes it to the app.

# =================================================================================================
# 1. CORE ROUTING, IMAGE & RUNTIME
# =================================================================================================
# public domain; its DNS A record must point to the VPS before the first start (Caddy gets the certificate)
APP_DOMAIN=nexora.example.com
# image to run: ghcr.io/<owner>/nexora-backend and the git sha or release tag (written by deploy.sh)
IMAGE_REPO=ghcr.io/OWNER/nexora-backend
IMAGE_TAG=0000000
SPRING_PROFILES_ACTIVE=prod
# JVM memory follows the container limit; exit on out-of-memory so Docker restarts the app
JAVA_OPTS=-XX:MaxRAMPercentage=75 -XX:+ExitOnOutOfMemoryError

# =================================================================================================
# 2. PRODUCTION DATABASE & MIGRATIONS
# =================================================================================================
DB_NAME=nexora_db
# three different passwords of at least 24 random characters (openssl rand -hex 24): admin, schema owner, application
POSTGRES_PASSWORD=
OWNER_DB_PASSWORD=
APP_DB_PASSWORD=
# the application connects as nexora_app; DB_PASSWORD equals APP_DB_PASSWORD
DB_URL=jdbc:postgresql://postgres:5432/nexora_db
DB_USERNAME=nexora_app
DB_PASSWORD=
# migrations run as nexora_owner; FLYWAY_PASSWORD equals OWNER_DB_PASSWORD
FLYWAY_URL=jdbc:postgresql://postgres:5432/nexora_db
FLYWAY_USER=nexora_owner
FLYWAY_PASSWORD=

# =================================================================================================
# 3. PRODUCTION SECURITY & IDENTITIES
# =================================================================================================
# HS256 key of at least 32 bytes: openssl rand -base64 48
JWT_SECRET=
# first OWNER account: needed only on the very first start; delete both lines after it
BOOTSTRAP_OWNER_USERNAME=
BOOTSTRAP_OWNER_PASSWORD=
# optional, with their defaults: JWT_ACCESS_TTL=15m JWT_REFRESH_TTL=7d LOGIN_MAX_FAILURES=5 LOGIN_LOCKOUT=15m
# RATE_LIMIT_ENABLED=true SERVER_PORT=8080 MANAGEMENT_PORT=8081 DOCUMENTS_DIR=/var/lib/nexora/documents (set by the image)

# =================================================================================================
# 4. BACKUPS & HEALTH ALERTS (RUNBOOK & HOST MONITORING)
# =================================================================================================
# age recipient public key (age1...); the private key is NOT on the server
AGE_PUBLIC_KEY=
# rclone remote:bucket with a write-only credential
RCLONE_REMOTE=nexora-backups:nexora-db
# dead-man's-switch URL pinged after each successful backup (https://hc-ping.com/<uuid>)
HEALTHCHECK_PING_URL=
# host-check.sh POSTs alerts here (e.g. https://ntfy.sh/<secret-topic>, which pushes to phones)
ALERT_WEBHOOK_URL=

# =================================================================================================
# 5. CI/CD & AUDIT DEPENDENCIES
# =================================================================================================
# Required for CI and ./gradlew dependencyCheckAnalyze (NFR-SEC-07, Gate M7/M8)
# NVD_API_KEY=

# =================================================================================================
# 6. POST-MVP & FUTURE INTEGRATIONS (TEMPLATES)
# =================================================================================================
# --- WhatsApp Business API notifications (FR-NTF-08) ---
# WHATSAPP_API_ENABLED=false
# WHATSAPP_API_URL=https://graph.facebook.com/v19.0
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=

