# SmartSilk Server Engine Configuration
# Port to expose the backend API service on the host
SERVER_PORT=8088

# PostgreSQL Database Configuration
DB_NAME=smartsilk_ledger_db
DB_USER=postgres
DB_PASSWORD=smartsilk_server_secure_password

# Master JWT Token Secret (at least 32 characters)
JWT_SECRET=smartsilk-server-production-master-jwt-secret-key-32chars
